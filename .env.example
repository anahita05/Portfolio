# Copy to .env.local for local development. NEVER commit real values.
#
# Vault password + JWT signing secret for the built-in Next.js auth routes
# (src/app/api/auth/*). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-a-long-random-secret
#
# Session lifetime in seconds (default 7 days)
JWT_EXPIRES_IN=604800
#
# Optional: point the frontend at the external Express backend (see ./backend)
# instead of the built-in routes. Leave empty for same-origin (Vercel + local dev).
# NEXT_PUBLIC_API_URL=http://localhost:4000
