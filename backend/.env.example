# Copy to .env and fill in real values. NEVER commit .env.
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:3000

# The vault password (compare against this, never send it to the client)
SECRET_PASSWORD=change-me-to-a-long-random-password

# Long random string used to sign JWTs (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-secret

# Session lifetime in seconds (default 7 days)
JWT_EXPIRES_IN=604800
